{
  "version": "2.0.0",
  "tasks": [
    {"label": "Course: Configure Debug", "type": "process", "command": "cmake",
     "args": ["--preset", "Debug"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "Course: Build Debug", "type": "process", "command": "cmake",
     "args": ["--build", "--preset", "Debug"], "options": {"cwd": "${workspaceFolder}"},
     "dependsOn": "Course: Configure Debug", "problemMatcher": ["$gcc"],
     "group": {"kind": "build", "isDefault": true}},
    {"label": "Course: Configure JumpDebug", "type": "process", "command": "cmake",
     "args": ["--preset", "JumpDebug"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "Course: Build JumpDebug", "type": "process", "command": "cmake",
     "args": ["--build", "--preset", "JumpDebug"], "options": {"cwd": "${workspaceFolder}"},
     "dependsOn": "Course: Configure JumpDebug", "problemMatcher": ["$gcc"]},
    {"label": "Course: Offline doctor", "type": "process", "command": "python",
     "args": ["tools/ota_tool.py", "doctor"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []}
  ]
}
