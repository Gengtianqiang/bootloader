#ifndef COURSE_LAYOUT_H
#define COURSE_LAYOUT_H
#define COURSE_FLASH_BASE  @COURSE_FLASH_BASE@UL
#define COURSE_FLASH_SIZE  @COURSE_FLASH_SIZE@UL
#define COURSE_BOOT_SIZE   @COURSE_BOOT_SIZE@UL
#define COURSE_APP_BASE    @COURSE_APP_BASE@UL
#define COURSE_APP_SIZE    @COURSE_APP_SIZE@UL
#define COURSE_FLASH_END   @COURSE_FLASH_END@UL
#define COURSE_RAM_BASE    @COURSE_RAM_BASE@UL
#define COURSE_RAM_END     @COURSE_RAM_END@UL
#define COURSE_HSE_HZ      @COURSE_HSE_HZ@UL
#define COURSE_SYSCLK_HZ   @COURSE_SYSCLK_HZ@UL
_Static_assert(COURSE_FLASH_BASE + COURSE_BOOT_SIZE == COURSE_APP_BASE, "Partition mismatch");
_Static_assert(COURSE_APP_BASE + COURSE_APP_SIZE == COURSE_FLASH_END, "Flash overflow");
#endif
