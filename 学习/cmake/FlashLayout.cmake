# One editable layout feeds the C header, BOTH linker scripts and Python tools.
set(_layout_file "${PROJECT_SOURCE_DIR}/config/flash_layout.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_layout_file}")
file(READ "${_layout_file}" _layout_json)
string(JSON COURSE_FLASH_BASE GET "${_layout_json}" flash_base)
string(JSON _flash_kib GET "${_layout_json}" flash_size_kib)
string(JSON _boot_kib GET "${_layout_json}" boot_size_kib)
string(JSON COURSE_RAM_BASE GET "${_layout_json}" ram_base)
string(JSON _ram_kib GET "${_layout_json}" ram_size_kib)
string(JSON COURSE_HSE_HZ GET "${_layout_json}" hse_hz)
string(JSON COURSE_SYSCLK_HZ GET "${_layout_json}" sysclk_hz)

# This course uses the F407ZE's documented 512 KiB Flash and 128 KiB ordinary SRAM.
if(NOT _flash_kib EQUAL 512 OR NOT _ram_kib EQUAL 128 OR
   NOT COURSE_FLASH_BASE STREQUAL "0x08000000" OR NOT COURSE_RAM_BASE STREQUAL "0x20000000")
    message(FATAL_ERROR "Changing MCU/memory banks requires porting this board, not just editing sizes.")
endif()
set(_allowed_boot_kib 16 32 48 64 128 256 384)
if(NOT _boot_kib IN_LIST _allowed_boot_kib)
    message(FATAL_ERROR "Boot/App boundary must be an F407 Flash sector boundary.")
endif()
if(NOT COURSE_HSE_HZ EQUAL 8000000 OR NOT COURSE_SYSCLK_HZ EQUAL 168000000)
    message(FATAL_ERROR "Clock changes require updating and reviewing the F407 PLL configuration.")
endif()
math(EXPR COURSE_FLASH_SIZE "${_flash_kib} * 1024")
math(EXPR COURSE_BOOT_SIZE "${_boot_kib} * 1024")
math(EXPR COURSE_APP_BASE "${COURSE_FLASH_BASE} + ${COURSE_BOOT_SIZE}" OUTPUT_FORMAT HEXADECIMAL)
math(EXPR COURSE_APP_SIZE "${COURSE_FLASH_SIZE} - ${COURSE_BOOT_SIZE}")
math(EXPR COURSE_FLASH_END "${COURSE_FLASH_BASE} + ${COURSE_FLASH_SIZE}" OUTPUT_FORMAT HEXADECIMAL)
math(EXPR COURSE_RAM_SIZE "${_ram_kib} * 1024")
math(EXPR COURSE_RAM_END "${COURSE_RAM_BASE} + ${COURSE_RAM_SIZE}" OUTPUT_FORMAT HEXADECIMAL)
file(MAKE_DIRECTORY "${PROJECT_BINARY_DIR}/generated")
configure_file("${PROJECT_SOURCE_DIR}/config/course_layout.h.in"
    "${PROJECT_BINARY_DIR}/generated/course_layout.h" @ONLY)
