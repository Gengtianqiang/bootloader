{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CMake Debug (J-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",
      "serverpath": "D:/jlink_software/JLinkGDBServerCL.exe",
      "serverArgs": [
        "-speed",
        "8000"
      ],
      "device": "STM32F407ZE",
      "interface": "swd",
      "armToolchainPath": "C:/Tools/ArmGNU/15.2.Rel1/bin",
      "gdbPath": "C:/Tools/ArmGNU/15.2.Rel1/bin/arm-none-eabi-gdb.exe",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/bootloader.elf",
      "svdFile": "${workspaceFolder}/.pack/Keil/STM32F4xx_DFP.2.14.0/CMSIS/SVD/STM32F40x.svd",
      "runToEntryPoint": "main",
      "preLaunchTask": "CMake: Build Debug"
    }
  ]
}
