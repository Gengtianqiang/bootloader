{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug",
                "--target",
                "otatest"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Configure Debug",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: Configure App-Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "App-Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Build App-Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "App-Debug",
                "--target",
                "otatest_bin"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Configure App-Debug",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "OTA: Build Encrypted Package",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/Build-Step2Package.ps1",
                "-InputElf",
                "${workspaceFolder}/build/App-Debug/otatest.elf",
                "-BuildCache",
                "${workspaceFolder}/build/App-Debug/CMakeCache.txt",
                "-OutputPackage",
                "${workspaceFolder}/build/App-Debug/otatest.step2.bin"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Build App-Debug",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "J-Link: Prepare App HEX",
            "type": "process",
            "command": "python",
            "args": [
                "${workspaceFolder}/tools/make_jlink_app_hex.py",
                "build/App-Debug/otatest.bin",
                "build/App-Debug/otatest.jlink.hex"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Build App-Debug",
            "problemMatcher": []
        },
        {
            "label": "J-Link: Download App",
            "type": "process",
            "command": "D:/jlink_software/JLink.exe",
            "args": [
                "-device",
                "STM32F407ZE",
                "-if",
                "SWD",
                "-speed",
                "4000",
                "-autoconnect",
                "1",
                "-ExitOnError",
                "1",
                "-CommandFile",
                "${workspaceFolder}/.vscode/flash-otatest.jlink"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "J-Link: Prepare App HEX",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
